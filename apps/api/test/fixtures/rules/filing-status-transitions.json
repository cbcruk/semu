{
  "rule": "filing-status-transitions",
  "description": "Tax filing status transitions: allowed source states, the actor (client or agency) and guards of each named transition.",
  "sources": [
    {
      "file": "apps/api/legacy/src/modules/filings/filing-status.ts",
      "lines": "4-19"
    },
    {
      "file": "apps/api/legacy/src/modules/filings/filings.service.ts",
      "lines": "237-259, 319-414"
    },
    {
      "file": "docs/reference/legacy-design/tax-api-design.md",
      "lines": "229-274, 739"
    },
    {
      "file": "manual/06-세무/01-부가세.md",
      "lines": "20-46"
    }
  ],
  "inputSchema": {
    "status": "Current legacy status (scheduled, requested, submitted, reviewing, ledger_pending, preparing, filed, settled, cancelled).",
    "transition": "Legacy transition name from TRANSITIONS.",
    "actor": "client or agency.",
    "taxType": "Legacy tax type (surtax, withholding_tax, corporation_tax, aggr_income_tax).",
    "kind": "Legacy filing kind (preliminary, final, notice, monthly, semiannual, annual).",
    "payableAmount": "Payable amount stored on the filing; negative is a refund.",
    "pendingClientItems": "Client-answerable requirement items still pending.",
    "hasReturnDocument": "An active return document is attached."
  },
  "cases": [
    {
      "name": "request scheduled by agency",
      "input": {
        "status": "scheduled",
        "transition": "request",
        "actor": "agency",
        "taxType": "surtax",
        "kind": "final",
        "payableAmount": null,
        "pendingClientItems": 0,
        "hasReturnDocument": false
      },
      "expected": {
        "ok": true,
        "to": "requested"
      },
      "derivation": "traced"
    },
    {
      "name": "request scheduled by client is denied",
      "input": {
        "status": "scheduled",
        "transition": "request",
        "actor": "client",
        "taxType": "surtax",
        "kind": "final",
        "payableAmount": null,
        "pendingClientItems": 0,
        "hasReturnDocument": false
      },
      "expected": {
        "ok": false,
        "code": "PERMISSION_DENIED"
      },
      "derivation": "traced"
    },

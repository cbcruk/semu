  ],
  "inputSchema": {
    "check": "period, sales-vat, estimate or trend.",
    "sales/purchases": "Legacy sales_evidence and purchase_evidence rows (deductible 1, 0 or null).",
    "taxableCardRatioBp": "Taxable share of card sales in basis points (10000 = 100%).",
    "filings": "Legacy VAT filings by year and quarter.",
    "estimates": "Evidence-based estimate per period, keyed start..end."
  },

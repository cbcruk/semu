{
  "rule": "password-policy",
  "description": "Password rules: 8-20 characters mixing letters and digits (client), no whitespace (legacy server), confirmation match, demo accounts cannot change, change revokes sessions, and the reset flow (always 202, single-use token with a 30-minute expiry).",
  "sources": [
    {
      "file": "docs/reference/spec/platform.md",
      "lines": "395-399",
      "origin": "index.pretty.js B:96790-96791"
    },
    {
      "file": "apps/api/legacy/src/modules/platform/auth/password.utils.ts",
      "lines": "37-51"
    },
    {
      "file": "apps/api/legacy/src/modules/platform/auth/auth.service.ts",
      "lines": "140-184"
    },
    {
      "file": "alfred-manual/10-개인-설정-안내.md",
      "lines": "26-28"
    }
  ],
  "inputSchema": {
    "check": "validate | change | requestReset | useResetToken.",
    "password": "New password.",
    "confirmPassword": "Confirmation field (confirm_password).",
    "userType": "Legacy UserType (0 client, 99 demo client).",
    "token": "Reset token state {issuedAt, usedAt, now}."
  },
  "cases": [
    {
      "name": "letters and digits within length",
      "input": { "check": "validate", "password": "semu2026", "confirmPassword": "semu2026" },
      "expected": { "client": "valid", "legacyServer": "valid" },
      "derivation": "traced"
    },
    {
      "name": "exactly 8 characters",
      "input": { "check": "validate", "password": "abcd1234", "confirmPassword": "abcd1234" },
      "expected": { "client": "valid", "legacyServer": "valid" },
      "derivation": "traced"
    },
    {
      "name": "7 characters",
      "input": { "check": "validate", "password": "abc1234", "confirmPassword": "abc1234" },
      "expected": { "client": "8자 이상 20자 이하의 영문, 숫자 혼용", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "exactly 20 characters",
      "input": { "check": "validate", "password": "abcdefghij1234567890", "confirmPassword": "abcdefghij1234567890" },
      "expected": { "client": "valid", "legacyServer": "valid" },
      "derivation": "traced"
    },
    {
      "name": "21 characters",
      "input": { "check": "validate", "password": "abcdefghij12345678901", "confirmPassword": "abcdefghij12345678901" },
      "expected": { "client": "8자 이상 20자 이하의 영문, 숫자 혼용", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "letters only",
      "input": { "check": "validate", "password": "abcdefgh", "confirmPassword": "abcdefgh" },
      "expected": { "client": "8자 이상 20자 이하의 영문, 숫자 혼용", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "digits only",
      "input": { "check": "validate", "password": "12345678", "confirmPassword": "12345678" },
      "expected": { "client": "8자 이상 20자 이하의 영문, 숫자 혼용", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "Korean letters do not count as letters",
      "input": { "check": "validate", "password": "가나다라1234", "confirmPassword": "가나다라1234" },
      "expected": { "client": "8자 이상 20자 이하의 영문, 숫자 혼용", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "special characters are allowed",
      "input": { "check": "validate", "password": "abcd123!", "confirmPassword": "abcd123!" },
      "expected": { "client": "valid", "legacyServer": "valid" },
      "derivation": "traced"
    },
    {
      "name": "whitespace passes the client but not the legacy server",
      "input": { "check": "validate", "password": "abcd 1234", "confirmPassword": "abcd 1234" },
      "expected": { "client": "valid", "legacyServer": { "code": "VALIDATION_FAILED", "field": "password" } },
      "derivation": "traced"
    },
    {
      "name": "confirmation mismatch",
      "input": { "check": "validate", "password": "abcd1234", "confirmPassword": "abcd12345" },
      "expected": { "legacyServer": { "code": "VALIDATION_FAILED", "field": "confirm_password" } },
      "derivation": "traced"
    },
    {
      "name": "demo account cannot change the password",
      "input": { "check": "change", "userType": 99, "password": "abcd1234", "confirmPassword": "abcd1234" },
      "expected": { "client": "hidden by isDemoUserType", "legacyServer": { "status": 403, "code": "DEMO_READ_ONLY" } },
      "derivation": "traced"
    },
    {
      "name": "change revokes every session and sends the client to /login",
      "input": { "check": "change", "userType": 0, "password": "newpass99", "confirmPassword": "newpass99", "sessions": 3 },
      "expected": { "status": 204, "revokedSessions": 3, "clientRedirect": "/login" },
      "derivation": "traced"
    },
    {
      "name": "reset request for an unknown email still answers 202",
      "input": { "check": "requestReset", "email": "nobody@example.com", "accountExists": false },
      "expected": { "status": 202, "mailSent": false },
      "derivation": "traced"
    },
    {
      "name": "reset request for a demo account sends nothing",
      "input": { "check": "requestReset", "email": "u-demo@example.com", "accountExists": true, "userType": 99 },
      "expected": { "status": 202, "mailSent": false },
      "derivation": "traced"
    },
    {
      "name": "reset token within 30 minutes",
      "input": {
        "check": "useResetToken",
        "token": { "issuedAt": "2026-11-01T09:00:00+09:00", "usedAt": null, "now": "2026-11-01T09:29:59+09:00" }
      },
      "expected": { "status": 204, "revokesSessions": true },
      "derivation": "traced"
    },
    {
      "name": "reset token at 30 minutes is expired",
      "input": {
        "check": "useResetToken",
        "token": { "issuedAt": "2026-11-01T09:00:00+09:00", "usedAt": null, "now": "2026-11-01T09:30:00+09:00" }
      },
      "expected": { "status": 410, "code": "GONE" },
      "derivation": "traced"
    },
    {
      "name": "reset token used twice",
      "input": {
        "check": "useResetToken",
        "token": { "issuedAt": "2026-11-01T09:00:00+09:00", "usedAt": "2026-11-01T09:05:00+09:00", "now": "2026-11-01T09:06:00+09:00" }
      },
      "expected": { "status": 410, "code": "GONE" },
      "derivation": "traced"
    },
    {
      "name": "unknown reset token",
      "input": { "check": "useResetToken", "token": null },
      "expected": { "status": 404, "code": "NOT_FOUND" },
      "derivation": "traced"
    }
  ],
  "openQuestions": [
    "The exact regular expressions of validatePasswordLength and validatePasswordCombination are not in the spec notes; which characters count as letters and whether symbols are allowed is assumed.",
    "Whitespace is accepted by the client but rejected by the legacy server, so the real server's whitespace rule is unknown.",
    "The reset token lifetime (30 minutes) and its single-use behaviour are proposals; the real nexus values are not visible.",
    "Whether changing the password keeps the current session or revokes all sessions is assumed from the client sending the user to /login.",
    "Whether the new password may equal the old one, and whether there is a login lockout after failed attempts, is not visible."
  ]
}

{
  "rule": "esign-send-validation",
  "description": "Checks an e-sign request before sending: recipient email and foreign visa, active templates, required admin fields, and the company seal to stamp.",
  "sources": [
    {
      "file": "apps/api/legacy/src/modules/hr/e-sign/e-sign-requests.service.ts",
      "lines": "348-385"
    },
    {
      "file": "manual/04-인사/03-전자서명.md",
      "lines": "76"
    },
    {
      "file": "docs/reference/spec/hr.md",
      "lines": "656"
    }
  ],
  "inputSchema": {
    "input": "recipient, documents with template fields, fieldValues, hiddenFields, employee sourceValues, chosen companySealId."
  },
  "cases": [
    {
      "name": "ready to send with template seal",
      "input": {
        "input": {
          "recipient": {
            "email": "worker@example.com",
            "isForeigner": false
          },
          "documents": [
            {
              "index": 0,
              "templateActive": true,
              "fields": [
                {
                  "key": "position",
                  "label": "position",
                  "type": "TEXT",
                  "required": true,
                  "hideable": false,
                  "signer": false
                }
              ],
              "defaultCompanySealId": "fle_seal"
            }
          ],
          "fieldValues": {
            "0": {
              "position": "매니저"
            }
          },
          "hiddenFields": {},
          "sourceValues": {}
        }
      },
      "expected": {
        "firstViolation": null,
        "companySealId": "fle_seal"
      },
      "derivation": "traced"
    },

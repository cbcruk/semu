{
  "rule": "filing-progress",
  "description": "Legacy progress step shown for a filing status (6 VAT steps, 5 for other taxes) and the derived overdue flag.",
  "sources": [
    {
      "file": "apps/api/legacy/src/modules/filings/process-step.ts",
      "lines": "4-38"
    },
    {
      "file": "apps/api/legacy/src/modules/filings/filings.serializer.ts",
      "lines": "9-13"
    },
    {
      "file": "apps/api/legacy/src/modules/tracker/tracker.service.ts",
      "lines": "10-30"
    },
    {
      "file": "docs/reference/legacy-design/tax-api-design.md",
      "lines": "39-68, 252-270, 410-422, 876-882"
    }
  ],
  "inputSchema": {
    "check": "step or overdue.",
    "taxType": "Legacy tax type.",
    "status": "Legacy status.",
    "today": "Asia/Seoul date."
